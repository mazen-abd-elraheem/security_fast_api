# ==============================================================
# SecureTrack Platform — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ==============================================================

# ── Database ──
MYSQL_ROOT_PASSWORD=          # Strong random password (32+ chars)
DB_PASSWORD=                  # Application DB user password (32+ chars)

# ── JWT / Auth ──
SECRET_KEY=                   # openssl rand -hex 64 (128 hex chars minimum)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Application ──
ENVIRONMENT=production
DEBUG=False
UPLOAD_DIR=/app/uploaded_images
MAX_UPLOAD_SIZE_MB=10

# ── CORS / Origins ──
ALLOWED_ORIGINS=["https://your-domain.com"]

# ── Rate Limiting ──
RATE_LIMIT_PER_MINUTE=60

# ── Geofence ──
DEFAULT_GEOFENCE_RADIUS_METERS=100

# ── SSL (for Nginx reverse proxy) ──
SSL_CERT_PATH=/etc/letsencrypt/live/your-domain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/your-domain.com/privkey.pem
